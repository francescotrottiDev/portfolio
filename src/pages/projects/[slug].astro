---
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectMedia from '../../components/projects/ProjectMedia.astro';
import ProjectVideo from '../../components/projects/ProjectVideo.astro';
import ProjectFigure from '../../components/projects/ProjectFigure.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import Arrow from '../../components/Arrow.astro';
import { getProjects } from '../../lib/projects';
import { categoryUrl, projectUrl, projectYear, relatedProjects, type Project } from '../../lib/project-utils';
import '../../styles/projects.css';
export async function getStaticPaths() {
  return (await getProjects()).map(project=>({params:{slug:project.data.slug},props:{project}}));
}
interface Props { project:Project; }
const { project } = Astro.props;
const data = project.data;
const projects = await getProjects();
const index = projects.findIndex(entry=>entry.id === project.id);
const previous = projects[index-1], next = projects[index+1];
const related = relatedProjects(project,projects);
const { Content, headings } = await render(project);
const contents = headings.filter(heading=>heading.depth === 2);
const videos = data.videos.slice(data.heroVideo ? 1 : 0);
const hasLinks = data.repository || data.demo || data.documentation.length > 0;
const displayDate = data.date ? new Date(data.date).toLocaleDateString('en', {year:'numeric',month:'long',day:'numeric',timeZone:'UTC'}) : undefined;
---
<SiteLayout title={`${data.title} — Francesco Trotti`} description={data.description} image={data.cover?.image.src} noindex={data.placeholder}>
  <article class="project-detail section-wrap">
    <nav class="project-breadcrumbs" aria-label="Breadcrumb"><a href="/projects/">Projects</a><span aria-hidden="true">/</span><span aria-current="page">{data.category}</span></nav>
    <header class="project-detail-header">
      <h1>{data.title}</h1>
      <p class="project-introduction">{data.description}</p>
      <dl class="project-metadata"><div><dt>Category</dt><dd><a href={categoryUrl(data.category)}>{data.category}</a></dd></div>{projectYear(project) && <div><dt>{data.date ? 'Date' : 'Year'}</dt><dd><time datetime={data.date ?? String(projectYear(project))}>{displayDate ?? projectYear(project)}</time></dd></div>}<div><dt>Status</dt><dd>{data.status}</dd></div></dl>
      {data.placeholder && <p class="project-placeholder-notice">Project placeholder. This entry is reserved for future work; it is not a claim of a completed or ongoing project.</p>}
    </header>
    {data.heroVideo && data.videos[0] ? <div class="detail-video-hero"><ProjectVideo video={data.videos[0]} /></div> : (data.cover || data.illustration) && <figure class="project-detail-cover"><div class="detail-cover"><ProjectMedia project={project} eager /></div>{data.cover?.caption && <figcaption>{data.cover.caption}</figcaption>}</figure>}
    <div class="project-reading-layout">
      {(contents.length > 0 || data.technologies.length > 0 || data.tags.length > 0) && <aside class="project-reading-index" aria-label="Project reference">
        {contents.length > 0 && <nav class="project-contents" aria-label="On this page"><h2>In these notes</h2><ul>{contents.map(heading=><li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
        {data.technologies.length > 0 && <section><h2>Technologies</h2><ul class="project-token-list">{data.technologies.map(technology=><li>{technology}</li>)}</ul></section>}
        {data.tags.length > 0 && <section><h2>Tags</h2><ul class="project-token-list">{data.tags.map(tag=><li>{tag}</li>)}</ul></section>}
      </aside>}
      <div class="project-prose">
        {data.longDescription && <p class="project-long-intro">{data.longDescription}</p>}
        {data.placeholderNote && <p class="project-author-note">{data.placeholderNote}</p>}
        <Content components={{ ProjectFigure }} />
      </div>
    </div>
    {data.images.length > 0 && <section class="project-media-section" aria-labelledby="project-images-title"><h2 id="project-images-title">Project images</h2><div class="project-image-gallery">{data.images.map(image=><ProjectFigure src={image.image} alt={image.alt} caption={image.caption} />)}</div></section>}
    {videos.length > 0 && <section class="project-media-section" aria-labelledby="project-videos-title"><h2 id="project-videos-title">Project videos</h2>{videos.map(video=><ProjectVideo video={video} />)}</section>}
    {hasLinks && <section class="project-resource-section" aria-labelledby="project-resources-title"><h2 id="project-resources-title">Project links</h2><ul>{data.repository && <li><a class="text-link" href={data.repository}>GitHub repository <Arrow /></a></li>}{data.demo && <li><a class="text-link" href={data.demo}>Live demo <Arrow /></a></li>}{data.documentation.map(link=><li><a class="text-link" href={link.url}>{link.label} <Arrow /></a></li>)}</ul></section>}
    <nav class="project-pagination" aria-label="Adjacent projects">{previous && <a href={projectUrl(previous)}><span>Previous project</span><strong>{previous.data.title}</strong></a>}{next && <a class="project-next" href={projectUrl(next)}><span>Next project</span><strong>{next.data.title}</strong></a>}</nav>
    <a class="text-link project-back" href="/projects/">Back to all projects <Arrow /></a>
    {related.length > 0 && <section class="project-related" aria-labelledby="related-projects-title"><h2 id="related-projects-title">Related projects</h2><div class="archive-grid">{related.map(entry=><ProjectCard project={entry} />)}</div></section>}
  </article>
</SiteLayout>

---
import '@fontsource-variable/archivo/standard.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import LinkageStudy from '../components/LinkageStudy.astro';
import { portfolio } from '../data/portfolio';
import { getFeaturedProjects } from '../lib/projects';
import { withBase } from '../lib/project-utils';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import ArrowIcon from '../components/Arrow.astro';
import '../styles/global.css';

const featured = await getFeaturedProjects();
---

<SiteLayout
  title={`${portfolio.name} — Inventor. Scientist. Engineer.`}
  description="Francesco Trotti — inventor and engineer exploring robotics, AI, and embedded systems. Building T labs. Building to serve the world."
  home
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">WHAT<br /><span>IF?</span></h1>
      <p class="hero-identity">{portfolio.title}</p>
      <p class="hero-mission">{portfolio.mission}</p>
      <a class="text-link hero-link" href="#work">Explore the work <ArrowIcon direction="down" /></a>
    </div>
    <LinkageStudy />
    <div class="hero-note"><span class="note-rule" aria-hidden="true"></span><p>A question is where<br />everything starts.</p></div>
    <div class="hero-bottom"><span>Robotics / AI / Embedded systems</span><span class="hero-scroll">A little further down <ArrowIcon direction="down" /></span></div>
  </section>

  <section class="work-section section-wrap" id="work" aria-labelledby="work-title">
    <div class="section-heading">
      <h2 id="work-title">Ideas made tangible<span class="accent">.</span></h2>
      <p>The work will live here.<br />Featured entries link to full project notes.</p>
    </div>
    <div class="project-grid">
      {featured.map((project, index) => <ProjectCard project={project} mode="home" featured={index === 0} />)}
    </div>
    <a class="text-link work-all-link" href={withBase('/projects/')}>View all projects <ArrowIcon /></a>
  </section>

  <section class="approach-section" id="approach" aria-labelledby="approach-title">
    <div class="section-wrap approach-layout">
      <div class="approach-intro"><h2 id="approach-title">From signal<br /><span>movement.</span></h2><p>Software doesn’t have to stop at the screen.</p></div>
      <div class="approach-content"><p class="large-copy">I’m drawn to the connections: intelligence that understands, electronics that respond, and mechanisms that act.</p><div class="discipline-row"><h3>Robotics</h3><p>Giving ideas a physical form.</p></div><div class="discipline-row"><h3>AI</h3><p>Exploring how machines can understand.</p></div><div class="discipline-row"><h3>Embedded</h3><p>Connecting software to the real world.</p></div></div>
    </div>
  </section>

  <section class="tlabs-section section-wrap" id="tlabs" aria-labelledby="tlabs-title">
    <div class="tlabs-panel">
      <div class="tlabs-heading"><h2 id="tlabs-title">T<span class="labs-word"> labs</span><span class="accent">.</span></h2><span class="venture-note">The venture I’m building</span></div>
      <div class="tlabs-body"><h3>Technology should<br />help the world.</h3><p>{portfolio.startup.description}</p><p class="tlabs-footnote">An ambition to build toward.<br />Not a claim of products or impact already delivered.</p><a class="text-link" href="#about">Meet the person behind it <ArrowIcon /></a></div>
      <svg class="tlabs-orbit" viewBox="0 0 600 600" fill="none" aria-hidden="true"><circle cx="300" cy="300" r="240"/><circle cx="300" cy="300" r="180"/><circle cx="300" cy="300" r="120"/><path d="M0 300h600M300 0v600"/><circle cx="300" cy="300" r="9" fill="currentColor"/></svg>
    </div>
  </section>

  <section class="about-section section-wrap" id="about" aria-labelledby="about-title">
    <div class="about-heading"><h2 id="about-title">A mind for systems.<br /><span>A reason to build.</span></h2><div class="signature">{portfolio.name}<span>Engineer · Building T labs</span></div></div>
    <div class="about-content"><p>{portfolio.introduction}</p><p>That curiosity is also behind T labs: a venture I’m building around robotics, AI, and the ambition to make technology useful to the world.</p><p class="placeholder-note">This is the beginning of the portfolio.<br />Real projects and a fuller story will follow.</p><a class="text-link" href="#work">Back to the work <ArrowIcon /></a></div>
  </section>
</SiteLayout>

<style>
  .work-all-link { margin-top: 30px; }
</style>
